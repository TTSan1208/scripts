#!name=Locket Gold (Personal)
#!desc=Mở khóa Locket Gold trọn đời, chặn quảng cáo, mở giới hạn camera 30s. Module được lưu trữ trên kho cá nhân.
#!system=ios

[Script]
# Xóa ETag để tránh lấy cache cũ
Locket_Req = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers)\/, script-path=https://raw.githubusercontent.com/TTSan1208/scripts/main/locket.js, requires-body=0

# Chặn phản hồi thật, trả về gói Gold
Locket_Gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers)\/, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/TTSan1208/scripts/main/locket.js

# Mở khóa tính năng ẩn (Firebase)
Locket_Features = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-img\/namespaces\/firebase:fetch, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/TTSan1208/scripts/main/locket.js

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
