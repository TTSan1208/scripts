#!name=Locket Gold (Personal)
#!desc=Module cấu hình Locket Gold cá nhân - Tích hợp toàn bộ Caption và mở khóa 30s.
# 🚀 Host by: TTSan1208

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Script]
# RevenueCat Response (Ép gói Gold)
Locket_Gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/TTSan1208/scripts/main/locket.js, requires-body=true, max-size=-1, timeout=60

# RevenueCat Request Header (Xóa ETag)
Locket_Req = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/TTSan1208/scripts/main/locket.js, timeout=60

# Locket Firebase Remote Config (Mở khóa tính năng & Captions)
Locket_Features = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.+\/.+, script-path=https://raw.githubusercontent.com/TTSan1208/scripts/main/locket.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
